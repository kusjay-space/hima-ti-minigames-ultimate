# ==========================================================
# Konfigurasi Lingkungan Minigames HIMA TI (Opsional)
# ==========================================================
# Salin file ini menjadi .env jika ingin mengubah pengaturan port default.
# cp .env.example .env

# Port untuk Backend Server & Serve Frontend Produksi (Default: 3000)
PORT=3000

# Port Backend khusus untuk Vite Proxy di mode 'npm run dev' (Default mengikuti PORT atau 3000)
VITE_BACKEND_PORT=3000
