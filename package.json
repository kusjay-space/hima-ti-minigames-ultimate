{
  "name": "minigames-hima-ti",
  "version": "1.0.0",
  "description": "Website Minigames Flashcard HIMA TI untuk Stand Ospek Mahasiswa Baru",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm run build --workspace=frontend && node backend/server.js",
    "build": "npm run build --workspace=frontend",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm run dev --workspace=frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "hima-ti",
    "minigames",
    "flashcard",
    "ospek"
  ],
  "author": "HIMA TI",
  "license": "ISC"
}
