{
  "name": "minigames-hima-ti",
  "version": "1.0.0",
  "private": true,
  "description": "Website Minigames Flashcard HIMA TI untuk Stand Ospek Mahasiswa Baru",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "npm run build --workspace=frontend && node backend/server.js",
    "build": "npm run build --workspace=frontend",
    "dev": "concurrently -k -n BACKEND,FRONTEND -c cyan.bold,magenta.bold npm:dev:backend npm:dev:frontend",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm run dev --workspace=frontend",
    "lint": "npm run lint --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "hima-ti",
    "minigames",
    "flashcard",
    "ospek"
  ],
  "author": "HIMA TI",
  "license": "ISC"
}
